@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:mod-cookbook:nhe-factotum#preset-a-bit-of-an-edge>
    a pset:Preset ;
    lv2:appliesTo <urn:mod-cookbook:nhe-factotum> ;
    rdfs:label "A bit of an edge" ;
    lv2:port [ lv2:symbol "gain" ; pset:value 5.6 ] ,
             [ lv2:symbol "clean" ; pset:value 7 ] ,
             [ lv2:symbol "contour" ; pset:value 3.7 ] ,
             [ lv2:symbol "tone" ; pset:value 5 ] ,
             [ lv2:symbol "level" ; pset:value 5.5 ] ,
             [ lv2:symbol "starve" ; pset:value 0 ] ,
             [ lv2:symbol "octave" ; pset:value 0 ] .

<urn:mod-cookbook:nhe-factotum#preset-death-valley>
