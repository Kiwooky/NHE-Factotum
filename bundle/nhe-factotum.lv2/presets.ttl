             [ lv2:symbol "clean" ; pset:value 7 ] ,
             [ lv2:symbol "contour" ; pset:value 4.2 ] ,
             [ lv2:symbol "tone" ; pset:value 1.5 ] ,
             [ lv2:symbol "level" ; pset:value 5.39 ] ,
             [ lv2:symbol "starve" ; pset:value 1 ] ,
             [ lv2:symbol "octave" ; pset:value 0 ] .

